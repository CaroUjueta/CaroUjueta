<svg width="900" height="120" viewBox="0 0 900 120" xmlns="http://www.w3.org/2000/svg" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <defs>
    <linearGradient id="bg" x1="100%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ff79c6"/>
      <stop offset="30%" stop-color="#6e40c9"/>
      <stop offset="65%" stop-color="#3a1c71"/>
      <stop offset="100%" stop-color="#0d1117"/>
    </linearGradient>
    <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="3" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>

  <rect width="900" height="120" fill="url(#bg)"/>

  <!-- estrellitas dispersas -->
  <g fill="#ffffff">
    <circle cx="60" cy="25" r="1.2"><animate attributeName="opacity" values="0.2;1;0.2" dur="2.2s" begin="0.1s" repeatCount="indefinite"/></circle>
    <circle cx="140" cy="60" r="1"><animate attributeName="opacity" values="0.2;0.9;0.2" dur="1.9s" begin="0.5s" repeatCount="indefinite"/></circle>
    <circle cx="220" cy="30" r="1.4"><animate attributeName="opacity" values="0.3;1;0.3" dur="2.5s" begin="0.9s" repeatCount="indefinite"/></circle>
    <circle cx="30" cy="90" r="1"><animate attributeName="opacity" values="0.2;0.8;0.2" dur="2s" begin="0.3s" repeatCount="indefinite"/></circle>
    <circle cx="300" cy="80" r="1.1"><animate attributeName="opacity" values="0.2;1;0.2" dur="2.3s" begin="1.1s" repeatCount="indefinite"/></circle>
    <circle cx="650" cy="20" r="1.3"><animate attributeName="opacity" values="0.2;1;0.2" dur="2.1s" begin="0.2s" repeatCount="indefinite"/></circle>
    <circle cx="720" cy="70" r="1"><animate attributeName="opacity" values="0.2;0.9;0.2" dur="1.8s" begin="0.6s" repeatCount="indefinite"/></circle>
    <circle cx="790" cy="35" r="1.2"><animate attributeName="opacity" values="0.3;1;0.3" dur="2.6s" begin="1s" repeatCount="indefinite"/></circle>
    <circle cx="850" cy="85" r="1"><animate attributeName="opacity" values="0.2;0.8;0.2" dur="2s" begin="0.4s" repeatCount="indefinite"/></circle>
    <circle cx="870" cy="20" r="1.1"><animate attributeName="opacity" values="0.2;1;0.2" dur="2.4s" begin="0.8s" repeatCount="indefinite"/></circle>
    <circle cx="450" cy="15" r="1"><animate attributeName="opacity" values="0.2;0.8;0.2" dur="1.9s" begin="0.7s" repeatCount="indefinite"/></circle>
    <circle cx="500" cy="95" r="1.2"><animate attributeName="opacity" values="0.2;0.9;0.2" dur="2.2s" begin="1.2s" repeatCount="indefinite"/></circle>
  </g>

  <!-- estrellas grandes de 4 puntas -->
  <g fill="#e6ccff" filter="url(#glow)">
    <path d="M105 45 L109 53 L117 56 L109 59 L105 67 L101 59 L93 56 L101 53 Z">
      <animate attributeName="opacity" values="0.5;1;0.5" dur="2.3s" begin="0.2s" repeatCount="indefinite"/>
      <animateTransform attributeName="transform" type="scale" values="1;1.3;1" additive="sum" dur="2.3s" begin="0.2s" repeatCount="indefinite"/>
    </path>
    <path d="M790 65 L793 71 L799 73 L793 75 L790 81 L787 75 L781 73 L787 71 Z">
      <animate attributeName="opacity" values="0.5;1;0.5" dur="2.7s" begin="0.6s" repeatCount="indefinite"/>
      <animateTransform attributeName="transform" type="scale" values="1;1.3;1" additive="sum" dur="2.7s" begin="0.6s" repeatCount="indefinite"/>
    </path>
    <path d="M400 40 L403 46 L409 48 L403 50 L400 56 L397 50 L391 48 L397 46 Z">
      <animate attributeName="opacity" values="0.4;1;0.4" dur="2.5s" begin="1s" repeatCount="indefinite"/>
      <animateTransform attributeName="transform" type="scale" values="1;1.3;1" additive="sum" dur="2.5s" begin="1s" repeatCount="indefinite"/>
    </path>
  </g>

  <!-- texto -->
  <text x="450" y="72" font-family="Verdana, Arial, sans-serif" font-size="16"
        fill="#e6ccff" text-anchor="middle" opacity="0.9" filter="url(#glow)">
    Gracias por visitar mi perfil ⋆
  </text>
</svg>
